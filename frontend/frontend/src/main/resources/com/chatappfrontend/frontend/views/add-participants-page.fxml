<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatappfrontend.frontend.controller.AddParticipantsController" styleClass="chat-area">

    <HBox styleClass="chat-header" alignment="CENTER_LEFT" spacing="10">
        <padding>
            <Insets top="10" bottom="10" left="15" right="15"/>
        </padding>

        <Button text="← Back" styleClass="settings-button" onAction="#handleBack"/>
        <Label text="Add Participants" styleClass="chat-name"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="15" left="15" right="15" bottom="10"/>
        </padding>

        <TextField fx:id="searchField" promptText="Search friends..." styleClass="search-field"/>

        <ListView fx:id="friendsList" VBox.vgrow="ALWAYS" styleClass="conversation-list"/>
    </VBox>
</VBox>